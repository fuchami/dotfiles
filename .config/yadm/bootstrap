#!/bin/sh

system_type=$(uname -s)

if [ "$system_type" = "Darwin" ]; then

  # install homebrew if it's missing
  if ! command -v brew >/dev/null 2>&1; then
    echo "Installing homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  # install mise if it's missing (brew packages & macOS defaults are managed by mise bootstrap)
  if ! command -v mise >/dev/null 2>&1; then
    echo "Installing mise"
    curl https://mise.run | sh
  fi

  # clone AstroNvim Config
  git clone git@github.com:fuchami/astronvim_config.git ~/.config/nvim

  # setup zsh
  echo 'export ZDOTDIR="$HOME"/.config/zsh' | sudo tee -a /etc/zshenv
  # history file
  mkdir -p ~/.local/state/zsh && touch mkdir ~/.local/state/zsh/history

  # brew packages + macOS defaults (managed in ~/.config/mise/config.toml)
  if command -v mise >/dev/null 2>&1; then
    mise bootstrap --only packages,macos-defaults --yes
  fi

fi
